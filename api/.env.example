NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Neon, Supabase, Docker, etc.)
# Use a DIRECT (non-pooled/non-pgbouncer) connection here — Prisma's
# interactive transactions ($transaction with a callback) are not
# compatible with PgBouncer transaction-mode pooling and will randomly
# fail with "Transaction not found" under load. On Neon, this means the
# hostname WITHOUT "-pooler" in it.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Same direct connection, used only by `prisma migrate`.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Optional — enables Redis-backed caching/rate limiting when set
REDIS_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

CLIENT_URL=http://localhost:3000
COOKIE_DOMAIN=

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
