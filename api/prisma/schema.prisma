generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoomRole {
  ADMIN
  ROOMMATE
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SplitMethod {
  EQUAL
  PERCENTAGE
  EXACT
  SHARES
  PAYER_ONLY
}

enum ExpenseStatus {
  ACTIVE
  PENDING_APPROVAL
  ARCHIVED
  DELETED
}

enum SettlementStatus {
  PENDING
  PARTIALLY_PAID
  SETTLED
  CANCELLED
}

enum NotificationType {
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_REQUESTED
  SETTLEMENT_COMPLETED
  BILL_UPCOMING
  BILL_OVERDUE
  BUDGET_WARNING
  BUDGET_EXCEEDED
  MEMBER_JOINED
  MEMBER_REMOVED
  INVITATION_ACCEPTED
  RECURRING_EXPENSE_CREATED
  PAYMENT_CONFIRMED
  ROOM_ANNOUNCEMENT
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum BillStatus {
  UPCOMING
  DUE
  PAID
  OVERDUE
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  APPROVE
  SETTLE
  JOIN
  LEAVE
  REMOVE
  SUSPEND
  INVITE
  ROLE_CHANGE
  LOGIN
  LOGOUT
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String?
  avatarUrl         String?
  emailVerified     Boolean   @default(false)
  googleId          String?   @unique
  currencyPref      String    @default("INR")
  themePref         String    @default("system")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions          Session[]
  emailTokens       EmailToken[]
  memberships       RoomMembership[]
  createdRooms      Room[]             @relation("RoomCreatedBy")
  invitationsSent   Invitation[]       @relation("InvitationInvitedBy")
  expensesPaid      ExpensePayer[]
  expenseShares     ExpenseParticipant[]
  createdExpenses   Expense[]          @relation("ExpenseCreatedBy")
  settlementsFrom   Settlement[]       @relation("SettlementFrom")
  settlementsTo     Settlement[]       @relation("SettlementTo")
  notifications     Notification[]
  activityLogs      ActivityLog[]
  receipts          Receipt[]
  recurringExpenses RecurringExpense[] @relation("RecurringCreatedBy")
  bills             Bill[]             @relation("BillCreatedBy")

  @@index([email])
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken  String   @unique
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  revokedAt     DateTime?

  @@index([userId])
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  token     String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type])
}

// ---------------------------------------------------------------------------
// Rooms / Membership / Invitations
// ---------------------------------------------------------------------------

model Room {
  id               String   @id @default(cuid())
  name             String
  type             String   @default("Flat")
  address          String?
  description      String?
  imageUrl         String?
  currency         String   @default("INR")
  timezone         String   @default("Asia/Kolkata")
  monthlyBudget    Decimal? @db.Decimal(12, 2)
  memberLimit      Int      @default(10)
  rules            String?
  inviteCode       String   @unique @default(cuid())
  isArchived       Boolean  @default(false)
  createdById      String
  createdBy        User     @relation("RoomCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships       RoomMembership[]
  invitations       Invitation[]
  expenses          Expense[]
  categories        Category[]
  settlements       Settlement[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
  recurringExpenses RecurringExpense[]
  bills             Bill[]
  budgets           Budget[]

  @@index([createdById])
}

model RoomMembership {
  id         String            @id @default(cuid())
  roomId     String
  room       Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       RoomRole          @default(ROOMMATE)
  status     MembershipStatus  @default(ACTIVE)
  joinedAt   DateTime          @default(now())
  leftAt     DateTime?
  upiId      String?

  @@unique([roomId, userId])
  @@index([userId])
  @@index([roomId])
}

model Invitation {
  id           String            @id @default(cuid())
  roomId       String
  room         Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  invitedById  String
  invitedBy    User              @relation("InvitationInvitedBy", fields: [invitedById], references: [id])
  email        String?
  code         String            @unique @default(cuid())
  role         RoomRole          @default(ROOMMATE)
  status       InvitationStatus  @default(PENDING)
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime          @default(now())

  @@index([roomId])
  @@index([code])
}

// ---------------------------------------------------------------------------
// Categories
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name      String
  icon      String   @default("tag")
  color     String   @default("#6366f1")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  bills             Bill[]
  budgetCategories  BudgetCategory[]

  @@unique([roomId, name])
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

model Expense {
  id            String        @id @default(cuid())
  roomId        String
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  amount        Decimal       @db.Decimal(12, 2)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id])
  date          DateTime      @default(now())
  splitMethod   SplitMethod   @default(EQUAL)
  status        ExpenseStatus @default(ACTIVE)
  notes         String?
  createdById   String
  createdBy     User          @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  archivedAt    DateTime?
  deletedAt     DateTime?

  payers        ExpensePayer[]
  participants  ExpenseParticipant[]
  receipts      Receipt[]

  @@index([roomId])
  @@index([roomId, date])
  @@index([categoryId])
}

// Supports multiple payers per expense (e.g. two people fronted the bill).
model ExpensePayer {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  amount    Decimal @db.Decimal(12, 2)

  @@unique([expenseId, userId])
}

model ExpenseParticipant {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  share     Decimal @db.Decimal(12, 2)
  percentage Decimal? @db.Decimal(5, 2)
  shares     Int?

  @@unique([expenseId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Recurring expenses / Bills
// ---------------------------------------------------------------------------

model RecurringExpense {
  id           String              @id @default(cuid())
  roomId       String
  room         Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title        String
  amount       Decimal             @db.Decimal(12, 2)
  categoryId   String?
  category     Category?           @relation(fields: [categoryId], references: [id])
  frequency    RecurringFrequency  @default(MONTHLY)
  splitMethod  SplitMethod         @default(EQUAL)
  startDate    DateTime
  nextDueDate  DateTime
  isActive     Boolean             @default(true)
  autoCreate   Boolean             @default(true)
  createdById  String
  createdBy    User                @relation("RecurringCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  expenses     Expense[]
  bills        Bill[]

  @@index([roomId])
}

model Bill {
  id                 String            @id @default(cuid())
  roomId             String
  room               Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title              String
  amount             Decimal           @db.Decimal(12, 2)
  categoryId         String?
  category           Category?         @relation(fields: [categoryId], references: [id])
  dueDate            DateTime
  status             BillStatus        @default(UPCOMING)
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  createdById        String
  createdBy          User              @relation("BillCreatedBy", fields: [createdById], references: [id])
  paidAt             DateTime?
  receiptUrl         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([roomId])
  @@index([roomId, status])
}

// ---------------------------------------------------------------------------
// Budgets
// ---------------------------------------------------------------------------

model Budget {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  month       Int
  year        Int
  totalAmount Decimal  @db.Decimal(12, 2)
  warningPct  Int      @default(80)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories  BudgetCategory[]

  @@unique([roomId, month, year])
}

model BudgetCategory {
  id         String   @id @default(cuid())
  budgetId   String
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)

  @@unique([budgetId, categoryId])
}

// ---------------------------------------------------------------------------
// Settlements
// ---------------------------------------------------------------------------

model Settlement {
  id            String           @id @default(cuid())
  roomId        String
  room          Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fromUserId    String
  fromUser      User             @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUserId      String
  toUser        User             @relation("SettlementTo", fields: [toUserId], references: [id])
  amount        Decimal          @db.Decimal(12, 2)
  status        SettlementStatus @default(PENDING)
  upiRef        String?
  paymentNote   String?
  screenshotUrl String?
  settledAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([roomId])
  @@index([fromUserId])
  @@index([toUserId])
}

// ---------------------------------------------------------------------------
// Receipts
// ---------------------------------------------------------------------------

model Receipt {
  id            String   @id @default(cuid())
  expenseId     String?
  expense       Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedById  String
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])
  fileUrl       String
  fileName      String
  mimeType      String
  sizeBytes     Int
  extractedData Json?
  createdAt     DateTime @default(now())

  @@index([expenseId])
}

// ---------------------------------------------------------------------------
// Notifications / Activity log
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId    String?
  room      Room?            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

model ActivityLog {
  id           String      @id @default(cuid())
  roomId       String
  room         Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User        @relation(fields: [actorId], references: [id])
  action       AuditAction
  entityType   String
  entityId     String?
  previousValue Json?
  newValue     Json?
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([roomId, createdAt])
}
